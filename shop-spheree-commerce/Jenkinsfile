
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        COMPOSE_PROJECT_NAME = 'shop-spheree-commerce'
        APP_URL = 'http://localhost'
        PROJECT_DIR = 'shop-spheree-commerce'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out ShopSphere source code...'
                checkout scm
            }
        }

        stage('Check Project Structure') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        set -e

                        echo "Checking project files..."

                        pwd
                        ls -la

                        test -f docker-compose.yml
                        test -f monitoring/prometheus/prometheus.yml
                        test -f monitoring/grafana/provisioning/datasources/prometheus.yml

                        echo "Project structure verified!"
                    '''
                }
            }
        }

        stage('Validate Docker Compose') {
            steps {
                dir("${PROJECT_DIR}") {
                    withCredentials([
                        file(
                            credentialsId: 'shopsphere-env',
                            variable: 'ENV_FILE'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "Checking Docker..."
                            docker --version

                            echo "Checking Docker Compose..."
                            docker-compose --version

                            echo "Validating Docker Compose..."

                            docker-compose \
                                --env-file "$ENV_FILE" \
                                -f docker-compose.yml config -q

                            echo "Configuration validation successful!"
                        '''
                    }
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                dir("${PROJECT_DIR}") {
                    withCredentials([
                        file(
                            credentialsId: 'shopsphere-env',
                            variable: 'ENV_FILE'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "Building ShopSphere images..."

                            docker-compose \
                                --env-file "$ENV_FILE" \
                                -f docker-compose.yml build

                            echo "Docker images built successfully!"
                        '''
                    }
                }
            }
        }

        stage('Deploy Application and Monitoring') {
            steps {
                dir("${PROJECT_DIR}") {
                    withCredentials([
                        file(
                            credentialsId: 'shopsphere-env',
                            variable: 'ENV_FILE'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "Deploying ShopSphere..."

                            docker-compose \
                                --env-file "$ENV_FILE" \
                                -f docker-compose.yml \
                                up -d --remove-orphans

                            echo "ShopSphere application deployed!"
                            echo "Prometheus and Grafana deployed!"
                        '''
                    }
                }
            }
        }

        stage('Verify Application') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        set -e

                        echo "Checking application containers..."

                        docker-compose ps

                        echo "Waiting for Product API..."

                        for i in $(seq 1 30); do

                            if curl -fsS \
                                "$APP_URL/api/products" > /dev/null; then

                                echo "Product API is responding!"
                                break
                            fi

                            if [ "$i" -eq 30 ]; then
                                echo "Product API health check failed!"
                                docker-compose ps
                                exit 1
                            fi

                            sleep 5
                        done

                        echo "Checking User API..."

                        curl -fsS "$APP_URL/api/users/health"

                        echo "Application verification successful!"
                    '''
                }
            }
        }

        stage('Verify Monitoring') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        set -e

                        echo "Checking monitoring containers..."

                        for service in prometheus grafana node-exporter cadvisor postgres-exporter; do

                            if ! docker-compose ps "$service" | grep -q "Up"; then
                                echo "ERROR: $service is not running!"
                                docker-compose logs --tail=50 "$service"
                                exit 1
                            fi

                            echo "$service is running!"
                        done

                        echo "Checking Prometheus readiness..."

                        for i in $(seq 1 20); do
                            if docker-compose exec -T prometheus \
                                wget -qO- http://localhost:9090/-/ready > /dev/null; then
                                echo "Prometheus is ready!"
                                break
                            fi

                            if [ "$i" -eq 20 ]; then
                                echo "Prometheus readiness check failed!"
                                exit 1
                            fi

                            sleep 3
                        done

                        echo "Checking Grafana readiness..."

                        for i in $(seq 1 20); do
                            if docker-compose exec -T grafana \
                                wget -qO- http://localhost:3000/api/health > /dev/null; then
                                echo "Grafana is ready!"
                                break
                            fi

                            if [ "$i" -eq 20 ]; then
                                echo "Grafana readiness check failed!"
                                exit 1
                            fi

                            sleep 3
                        done

                        echo "All monitoring services are ready!"
                    '''
                }
            }
        }

        stage('Final Deployment Status') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        echo "Final ShopSphere container status..."

                        docker-compose ps

                        echo "Deployment and monitoring verification completed!"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: ShopSphere and monitoring deployed successfully!'
        }

        failure {
            echo 'FAILED: ShopSphere deployment or monitoring verification failed.'

            dir('shop-spheree-commerce') {
                sh '''
                    docker-compose ps || true
                '''
            }
        }

        always {
            echo 'ShopSphere CI/CD pipeline finished.'
        }
    }
}
