
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        COMPOSE_PROJECT_NAME = 'shop-spheree-commerce'
        APP_URL = 'http://localhost'
        PROJECT_DIR = 'shop-spheree-commerce'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out ShopSphere source code...'
                checkout scm
            }
        }

        stage('Check Project Structure') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        set -e

                        echo "Checking project files..."
                        pwd
                        ls -la

                        test -f docker-compose.yml

                        echo "Docker Compose file found!"
                    '''
                }
            }
        }

        stage('Validate Docker Compose') {
            steps {
                dir("${PROJECT_DIR}") {
                    withCredentials([
                        file(
                            credentialsId: 'shopsphere-env',
                            variable: 'ENV_FILE'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "Checking Docker..."
                            docker --version

                            echo "Checking Docker Compose..."
                            docker-compose --version

                            echo "Validating Docker Compose configuration..."
                            docker-compose \
                                --env-file "$ENV_FILE" \
                                -f docker-compose.yml config -q

                            echo "Configuration validation successful!"
                        '''
                    }
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                dir("${PROJECT_DIR}") {
                    withCredentials([
                        file(
                            credentialsId: 'shopsphere-env',
                            variable: 'ENV_FILE'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "Building ShopSphere images..."

                            docker-compose \
                                --env-file "$ENV_FILE" \
                                -f docker-compose.yml build

                            echo "Docker images built successfully!"
                        '''
                    }
                }
            }
        }

        stage('Deploy Application') {
            steps {
                dir("${PROJECT_DIR}") {
                    withCredentials([
                        file(
                            credentialsId: 'shopsphere-env',
                            variable: 'ENV_FILE'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "Deploying ShopSphere..."

                            docker-compose \
                                --env-file "$ENV_FILE" \
                                -f docker-compose.yml \
                                up -d --remove-orphans

                            echo "Deployment completed!"
                        '''
                    }
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        set -e

                        echo "Checking running containers..."

                        docker-compose \
                            -f docker-compose.yml ps

                        echo "Waiting for Product API..."

                        for i in $(seq 1 30); do

                            if curl -fsS \
                                "$APP_URL/api/products" > /dev/null; then

                                echo "Product API is responding!"
                                break
                            fi

                            if [ "$i" -eq 30 ]; then
                                echo "Product API health check failed!"

                                docker-compose \
                                    -f docker-compose.yml ps

                                exit 1
                            fi

                            sleep 5
                        done

                        echo "Checking User API..."

                        curl -fsS "$APP_URL/api/users/health"

                        echo "Checking final container status..."

                        docker-compose \
                            -f docker-compose.yml ps

                        echo "ShopSphere verification completed!"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: ShopSphere deployed successfully!'
        }

        failure {
            echo 'FAILED: ShopSphere deployment failed.'

            dir('shop-spheree-commerce') {
                sh '''
                    docker-compose \
                        -f docker-compose.yml ps || true
                '''
            }
        }

        always {
            echo 'ShopSphere CI/CD pipeline finished.'
        }
    }
}
